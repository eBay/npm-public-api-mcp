{
  "name": "@ebay/npm-public-api-mcp",
  "version": "1.2.0",
  "description": "MCP server for eBay API with OpenAPI support",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "ebay",
    "ebay-api",
    "marketplace",
    "ai-assistant",
    "claude"
  ],
  "author": "eBay Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eBay/npm-public-api-mcp"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "ajv": "^8.18.0",
    "axios": "^1.15.0",
    "dotenv": "^16.5.0",
    "js-yaml": "^4.1.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.20.3",
    "zod": "^3.25.0"
  },
  "overrides": {
    "minimatch": "^9.0.6",
    "tar": "^7.5.3",
    "path-to-regexp": "^8.4.0",
    "brace-expansion": "^2.0.2",
    "glob": "^10.5.0",
    "picomatch": "^4.0.4",
    "qs": "^6.14.1",
    "fast-uri": "^3.1.3",
    "body-parser": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitest/ui": "^4.1.5",
    "eslint": "^8.57.0",
    "globals": "^16.3.0",
    "snyk": "^1.1297.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "npm@11.19.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "ebay-mcp-server": "dist/index.js"
  }
}
